# Base URL of the Chat-To-Dashboard REST API.
# "/api" is a relative path: it is served by the Vite dev proxy (see
# vite.config.ts), which forwards it to http://localhost:8000. Requests stay
# same-origin, so the browser never needs a CORS preflight.
# Set an absolute URL (e.g. http://localhost:8000/api) to call the backend
# directly instead - that only works if the backend allows this origin in its
# CORS_ALLOWED_ORIGINS.
VITE_API_BASE_URL=/api

# Where the dashboard data comes from:
#   "api"  -> always call the backend and surface errors (default)
#   "auto" -> call the backend, fall back to demo data if the call fails
#   "mock" -> always use demo data
VITE_DATA_SOURCE=api
